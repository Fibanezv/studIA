<?xml version="1.0" encoding="utf-8"?>
<!-- Rounded rectangle used as BottomNavigationView active-item indicator.
     Adjust corner radius and gradient stops here to change shape/shade. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Slight vertical padding inside the nav; keep transparent inset via padding on container if needed -->
    <size android:height="40dp" />

    <!-- Rounded corners; change to e.g. 12dp or 24dp to alter pill shape -->
    <corners android:radius="20dp" />

    <!-- Use a single solid color (existing semantic color) to avoid missing color resources.
         If you want a gradient/shade, we can add beige_200/400/500 colors to colors.xml
         or use explicit hex values here. -->
    <solid android:color="@color/beige_300_theme" />

</shape>
