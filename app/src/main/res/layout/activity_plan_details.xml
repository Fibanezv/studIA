<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:windowBackground">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ScrollView
            android:id="@+id/scroll_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@id/study_nav"
            android:padding="16dp">

            <LinearLayout
                android:orientation="vertical"
                android:padding="0dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <include layout="@layout/include_app_header" />

                <!-- Plan title -->
                <TextView
                    android:id="@+id/user_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Plan name"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:textColor="?attr/navTextColor"
                    android:layout_marginBottom="10dp"
                    android:textAlignment="center"
                    android:transitionName="plan_title"/>

                <!-- Stats (highlighted) - card style like User Activity, adapted for single plan -->
                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="4dp"
                    android:layout_marginBottom="10dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:background="@color/colorPrimary">

                        <!-- Overview Grid -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:padding="16dp"
                            android:gravity="center">

                            <!-- Flashcards Overview -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:gravity="center">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Total"
                                    android:textStyle="bold"
                                    android:textSize="11sp"
                                    android:textColor="@color/beige_300_theme"
                                    android:layout_marginBottom="4dp" />

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:gravity="center_vertical">

                                    <ImageView
                                        android:layout_width="28dp"
                                        android:layout_height="28dp"
                                        android:layout_marginEnd="6dp"
                                        android:src="@drawable/ic_flashcard_24"
                                        android:contentDescription="Flashcards"
                                        app:tint="@color/beige_300_theme" />

                                    <TextView
                                        android:id="@+id/tv_overview_flashcards_total"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="0"
                                        android:textStyle="bold"
                                        android:textSize="18sp"
                                        android:textColor="@color/black" />

                                </LinearLayout>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Flashcards"
                                    android:textStyle="bold"
                                    android:textSize="11sp"
                                    android:textColor="@color/beige_300_theme"
                                    android:layout_marginTop="4dp" />

                            </LinearLayout>

                            <!-- Separator -->
                            <View
                                android:layout_width="2dp"
                                android:layout_height="match_parent"
                                android:background="@color/beige_300_theme"
                                android:layout_marginHorizontal="8dp" />

                            <!-- Hot Topics Overview -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:gravity="center">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Total"
                                    android:textStyle="bold"
                                    android:textSize="11sp"
                                    android:textColor="@color/beige_300_theme"
                                    android:layout_marginBottom="4dp" />

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:gravity="center_vertical">

                                    <ImageView
                                        android:layout_width="28dp"
                                        android:layout_height="28dp"
                                        android:layout_marginEnd="6dp"
                                        android:src="@drawable/ic_hot_topics_24"
                                        android:contentDescription="Hot Topics"
                                        app:tint="@color/beige_300_theme" />

                                    <TextView
                                        android:id="@+id/tv_overview_hot_topics_total"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="0"
                                        android:textStyle="bold"
                                        android:textSize="18sp"
                                        android:textColor="@color/black" />

                                </LinearLayout>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Hot Topics"
                                    android:textStyle="bold"
                                    android:textSize="11sp"
                                    android:textColor="@color/beige_300_theme"
                                    android:layout_marginTop="4dp" />

                            </LinearLayout>

                            <!-- Separator -->
                            <View
                                android:layout_width="2dp"
                                android:layout_height="match_parent"
                                android:background="@color/beige_300_theme"
                                android:layout_marginHorizontal="8dp" />

                            <!-- Quizzes Overview -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:gravity="center">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Total"
                                    android:textStyle="bold"
                                    android:textSize="11sp"
                                    android:textColor="@color/beige_300_theme"
                                    android:layout_marginBottom="4dp" />

                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:gravity="center_vertical">

                                    <ImageView
                                        android:layout_width="28dp"
                                        android:layout_height="28dp"
                                        android:layout_marginEnd="6dp"
                                        android:src="@drawable/ic_quizz_24"
                                        android:contentDescription="Quizzes"
                                        app:tint="@color/beige_300_theme" />

                                    <TextView
                                        android:id="@+id/tv_overview_quizzes_total"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="0"
                                        android:textStyle="bold"
                                        android:textSize="18sp"
                                        android:textColor="@color/black" />

                                </LinearLayout>

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Quizzes"
                                    android:textStyle="bold"
                                    android:textSize="11sp"
                                    android:textColor="@color/beige_300_theme"
                                    android:layout_marginTop="4dp" />

                            </LinearLayout>

                        </LinearLayout>

                        <!-- Separator -->
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/beige_300_theme"
                            android:layout_marginHorizontal="12dp" />

                        <!-- Stats Grid Section -->
                        <LinearLayout
                            android:id="@+id/progress_section"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Progreso"
                                android:textStyle="bold"
                                android:textSize="16sp"
                                android:textColor="@color/beige_300_theme"
                                android:textAlignment="center"/>

                            <!-- Progress Bars Container -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:paddingVertical="12dp"
                                android:paddingHorizontal="16dp">

                                <!-- Flashcards Progress -->
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical"
                                    android:layout_marginBottom="12dp">

                                    <!-- Label -->
                                    <TextView
                                        android:id="@+id/tv_flashcards_label"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Flashcards progreso (0/0)"
                                        android:textSize="13sp"
                                        android:textStyle="bold"
                                        android:textColor="@color/black"
                                        android:layout_marginBottom="4dp" />

                                    <!-- Progress Bar -->
                                    <FrameLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="16dp"
                                        android:background="@android:color/transparent">

                                        <ProgressBar
                                            android:id="@+id/progress_flashcards"
                                            style="?android:attr/progressBarStyleHorizontal"
                                            android:layout_width="match_parent"
                                            android:layout_height="match_parent"
                                            android:minHeight="12dp"
                                            android:max="100"
                                            android:progress="0"
                                            android:progressDrawable="@drawable/progress_bar_rounded" />

                                        <TextView
                                            android:id="@+id/tv_flashcards_pct"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_gravity="center"
                                            android:text="0%"
                                            android:textStyle="bold"
                                            android:textSize="13sp"
                                            android:textColor="@color/black" />

                                    </FrameLayout>

                                </LinearLayout>

                                <!-- Quizzes Completados -->
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical"
                                    android:layout_marginBottom="12dp">

                                    <TextView
                                        android:id="@+id/tv_quizzes_completed_label"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Quizzes completados (0/0)"
                                        android:textSize="13sp"
                                        android:textStyle="bold"
                                        android:textColor="@color/black"
                                        android:layout_marginBottom="4dp" />

                                    <FrameLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="16dp"
                                        android:background="@android:color/transparent">

                                        <ProgressBar
                                            android:id="@+id/progress_quizzes_completed"
                                            style="?android:attr/progressBarStyleHorizontal"
                                            android:layout_width="match_parent"
                                            android:layout_height="match_parent"
                                            android:minHeight="12dp"
                                            android:max="100"
                                            android:progress="0"
                                            android:progressDrawable="@drawable/progress_bar_rounded" />

                                        <TextView
                                            android:id="@+id/tv_quizzes_completed_pct"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_gravity="center"
                                            android:text="0%"
                                            android:textStyle="bold"
                                            android:textSize="13sp"
                                            android:textColor="@color/black" />

                                    </FrameLayout>

                                </LinearLayout>

                                <!-- Preguntas Respondidas -->
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical"
                                    android:layout_marginBottom="12dp">

                                    <TextView
                                        android:id="@+id/tv_questions_answered_label"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Preguntas respondidas (0/0)"
                                        android:textSize="13sp"
                                        android:textStyle="bold"
                                        android:textColor="@color/black"
                                        android:layout_marginBottom="4dp" />

                                    <FrameLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="16dp"
                                        android:background="@android:color/transparent">

                                        <ProgressBar
                                            android:id="@+id/progress_questions_answered"
                                            style="?android:attr/progressBarStyleHorizontal"
                                            android:layout_width="match_parent"
                                            android:layout_height="match_parent"
                                            android:minHeight="13dp"
                                            android:max="100"
                                            android:progress="0"
                                            android:progressDrawable="@drawable/progress_bar_rounded" />

                                        <TextView
                                            android:id="@+id/tv_questions_answered_pct"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_gravity="center"
                                            android:text="0%"
                                            android:textStyle="bold"
                                            android:textSize="13sp"
                                            android:textColor="@color/black" />

                                    </FrameLayout>

                                </LinearLayout>

                                <!-- Preguntas Acertadas -->
                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical">

                                    <TextView
                                        android:id="@+id/tv_questions_correct_label"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Preguntas acertadas (0/0)"
                                        android:textSize="13sp"
                                        android:textStyle="bold"
                                        android:textColor="@color/black"
                                        android:layout_marginBottom="4dp" />

                                    <FrameLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="16dp"
                                        android:background="@android:color/transparent">

                                        <ProgressBar
                                            android:id="@+id/progress_questions_correct"
                                            style="?android:attr/progressBarStyleHorizontal"
                                            android:layout_width="match_parent"
                                            android:layout_height="match_parent"
                                            android:minHeight="14dp"
                                            android:max="100"
                                            android:progress="0"
                                            android:progressDrawable="@drawable/progress_bar_rounded" />

                                        <TextView
                                            android:id="@+id/tv_questions_correct_pct"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_gravity="center"
                                            android:text="0%"
                                            android:textStyle="bold"
                                            android:textSize="13sp"
                                            android:textColor="@color/black" />

                                    </FrameLayout>

                                </LinearLayout>

                            </LinearLayout>

                        </LinearLayout>

                        <!-- Separator for Description -->
                        <View
                            android:id="@+id/separator_description"
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/beige_300_theme"
                            android:layout_marginTop="8dp"
                            android:layout_marginLeft="12dp"
                            android:layout_marginRight="12dp"
                            android:visibility="gone" />

                        <!-- Description Section -->
                        <LinearLayout
                            android:id="@+id/description_section"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="12dp"
                            android:visibility="gone">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Descripción"
                                android:textStyle="bold"
                                android:textSize="16sp"
                                android:textColor="@color/beige_300_theme"
                                android:textAlignment="center"
                                android:layout_marginBottom="8dp" />

                            <TextView
                                android:id="@+id/tv_plan_description"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text=""
                                android:textSize="13sp"
                                android:textColor="@color/black"
                                android:lineSpacingExtra="2dp" />

                        </LinearLayout>

                        <!-- Separator for Badges -->
                        <View
                            android:id="@+id/separator_badges"
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/beige_300_theme"
                            android:layout_marginTop="8dp"
                            android:layout_marginLeft="12dp"
                            android:layout_marginRight="12dp"
                            android:visibility="gone" />

                        <!-- Badges Section -->
                        <LinearLayout
                            android:id="@+id/badges_section"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="12dp"
                            android:visibility="gone">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Logros"
                                android:textStyle="bold"
                                android:textSize="16sp"
                                android:textColor="@color/beige_300_theme"
                                android:textAlignment="center"
                                android:layout_marginBottom="8dp" />

                            <GridLayout
                                android:id="@+id/badges_container"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:columnCount="4"
                                android:orientation="horizontal"
                                android:useDefaultMargins="true"
                                android:alignmentMode="alignMargins"
                                android:gravity="center" />

                        </LinearLayout>

                    </LinearLayout>

                </androidx.cardview.widget.CardView>
                
                <!-- Action Buttons -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="8dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/user_reset_plan"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Reiniciar Plan"
                        android:layout_marginTop="10dp"
                        app:backgroundTint="?attr/actionButtonColor"
                        android:textColor="@color/white" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/user_delete_plan"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Eliminar Plan"
                        android:layout_marginTop="5dp"
                        app:backgroundTint="@color/red"
                        android:textColor="@color/white" />

                </LinearLayout>

            </LinearLayout>

        </ScrollView>

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/study_nav"
            android:layout_alignParentBottom="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:labelVisibilityMode="labeled"
            app:menu="@menu/menu_study_nav"
            android:background="@android:color/transparent"
            app:itemRippleColor="@android:color/transparent"
            app:itemIconTint="@color/selector_nav_color"
            app:itemTextColor="@color/selector_nav_text"
            app:itemActiveIndicatorStyle="@style/CustomActiveIndicator"/>

    </RelativeLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        app:headerLayout="@layout/nav_header_drawer"
        app:menu="@menu/drawer_menu"
        app:itemIconTint="@color/black"
        app:itemTextColor="@color/black"
        app:itemTextAppearance="@style/DrawerMenuTextAppearance" />

</androidx.drawerlayout.widget.DrawerLayout>