<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    app:cardElevation="4dp"
    app:cardCornerRadius="10dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="12dp"
        android:background="@color/beige_300_theme">

        <!-- Only show the question title in the list; clicking opens the detail card -->
        <TextView
            android:id="@+id/item_flashcard_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/colorPrimary"
            android:layout_marginBottom="4dp" />

        <!-- Status icon shown when the flashcard is completed -->
        <ImageView
            android:id="@+id/item_flashcard_status"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_question_ok_20"
            android:contentDescription="Completada"
            android:visibility="gone"
            android:layout_marginTop="6dp"
            android:layout_marginStart="2dp"
            android:layout_marginBottom="2dp" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
