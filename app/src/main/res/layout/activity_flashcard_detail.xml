<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:windowBackground">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:id="@+id/content_container"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@id/study_nav">

            <include layout="@layout/include_app_header" />


                <FrameLayout
                    android:id="@+id/detail_card"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_gravity="center">

                    <!-- Front card: question (beige background) -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/detail_front_card"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="8dp"
                        app:cardUseCompatPadding="true"
                        android:background="@color/beige_300_theme"
                        android:backgroundTint="@color/beige_300_theme">

                        <TextView
                            android:id="@+id/detail_front_text"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:textSize="36sp"
                            android:textStyle="bold"
                            android:textColor="@color/black"
                            android:padding="16dp" />

                    </androidx.cardview.widget.CardView>

                    <!-- Back card: answer (primary background, beige bold text) -->
                    <androidx.cardview.widget.CardView
                        android:id="@+id/detail_back_card"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        app:cardCornerRadius="12dp"
                        app:cardElevation="8dp"
                        app:cardUseCompatPadding="true"
                        android:background="@color/colorPrimary"
                        android:backgroundTint="@color/colorPrimary"
                        android:visibility="gone">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:id="@+id/detail_back_text"
                                android:layout_width="match_parent"
                                android:layout_height="0dp"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:textSize="18sp"
                                android:textStyle="bold"
                                android:textColor="@color/beige_300_theme" />

                            <!-- Botones de navegación estilo Tinder -->
                            <LinearLayout
                                android:id="@+id/flashcard_nav_buttons"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="horizontal"
                                android:gravity="center"
                                android:layout_marginTop="16dp"
                                android:layout_marginBottom="8dp">

                                <!-- Botón Anterior -->
                                <com.google.android.material.floatingactionbutton.FloatingActionButton
                                    android:id="@+id/btn_flashcard_previous"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_margin="8dp"
                                    app:fabSize="normal"
                                    app:backgroundTint="@color/white"
                                    app:tint="@color/colorPrimary"
                                    android:src="@android:drawable/ic_media_previous"
                                    android:contentDescription="@string/previous" />

                                <!-- Botón X (cerrar/no me gusta) -->
                                <com.google.android.material.floatingactionbutton.FloatingActionButton
                                    android:id="@+id/btn_flashcard_discard"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_margin="8dp"
                                    app:fabSize="normal"
                                    app:backgroundTint="@color/colorAccent"
                                    app:tint="@color/white"
                                    android:src="@android:drawable/ic_delete"
                                    android:contentDescription="@string/discard" />

                                <!-- Botón Like (favorito) -->
                                <com.google.android.material.floatingactionbutton.FloatingActionButton
                                    android:id="@+id/btn_flashcard_favorite"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_margin="8dp"
                                    app:fabSize="normal"
                                    app:backgroundTint="@color/colorSecondary"
                                    app:tint="@color/colorOnSecondary"
                                    android:src="@android:drawable/btn_star_big_on"
                                    android:contentDescription="@string/favorite" />

                                <!-- Botón Reload (aleatorio) - solo visible en modo aleatorio -->
                                <com.google.android.material.floatingactionbutton.FloatingActionButton
                                    android:id="@+id/btn_flashcard_reload"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_margin="8dp"
                                    app:fabSize="normal"
                                    app:backgroundTint="@color/colorPrimaryVariant"
                                    app:tint="@color/white"
                                    android:src="@android:drawable/ic_popup_sync"
                                    android:contentDescription="@string/another_random"
                                    android:visibility="gone" />

                                <!-- Botón Siguiente -->
                                <com.google.android.material.floatingactionbutton.FloatingActionButton
                                    android:id="@+id/btn_flashcard_next"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_margin="8dp"
                                    app:fabSize="normal"
                                    app:backgroundTint="@color/white"
                                    app:tint="@color/colorPrimary"
                                    android:src="@android:drawable/ic_media_next"
                                    android:contentDescription="@string/next" />

                            </LinearLayout>

                        </LinearLayout>

                    </androidx.cardview.widget.CardView>

                </FrameLayout>

        </LinearLayout>
        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/study_nav"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            app:labelVisibilityMode="labeled"
            app:menu="@menu/menu_study_nav"
            android:background="@android:color/transparent"
            app:itemRippleColor="@android:color/transparent"
            app:itemIconTint="@color/selector_nav_color"
            app:itemTextColor="@color/selector_nav_text"
            app:itemActiveIndicatorStyle="@style/CustomActiveIndicator" />

    </RelativeLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        app:headerLayout="@layout/nav_header_drawer"
        app:menu="@menu/drawer_menu"
        app:itemIconTint="@color/black"
        app:itemTextColor="@color/black"
        app:itemTextAppearance="@style/DrawerMenuTextAppearance" />

</androidx.drawerlayout.widget.DrawerLayout>
