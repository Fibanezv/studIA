<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <include layout="@layout/include_app_header" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:background="@color/colorPrimary">

                    <!-- Inline processing view (kept for backward compatibility but not used by OverlayManager) -->
                    <FrameLayout
                        android:id="@+id/processing_inline_overlay"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="gone"
                        android:padding="8dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">
                            <ProgressBar
                                android:id="@+id/processing_progress_inline"
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                style="?android:attr/progressBarStyleLarge"
                                android:indeterminate="true" />

                            <TextView
                                android:id="@+id/processing_status_inline"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:text="Procesando..."
                                android:textColor="@color/beige_300_theme"
                                android:textSize="16sp"/>
                        </LinearLayout>

                    </FrameLayout>

                    <!-- Formulario de especificaciones del plan -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Titulo del Plan de Estudio"
                        android:layout_marginTop="8dp"
                        android:textSize="20sp"
                        android:textColor="@color/beige_300_theme"
                        android:textStyle="bold"/>

                    <EditText
                        android:id="@+id/input_plan_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="e.g. História - El Imperio Romano"
                        android:inputType="text"
                        android:textSize="16sp"
                        android:textColor="@color/beige_300_theme"
                        android:textColorHint="@color/beige_300_theme"/>


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="8dp"
                            android:layout_height="wrap_content" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:layout_marginTop="8dp">

                            <!-- Idioma block: full width title + spinner -->
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Idioma"
                                android:textSize="20sp"
                                android:textColor="@color/beige_300_theme"
                                android:textStyle="bold" />

                            <Spinner
                                android:id="@+id/spinner_language"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:entries="@array/languages" />

                            <!-- Small spacer -->
                            <View
                                android:layout_width="match_parent"
                                android:layout_height="8dp" />

                            <!-- Nivel block: full width title + spinner -->
                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Nivel"
                                android:textSize="20sp"
                                android:textColor="@color/beige_300_theme"
                                android:textStyle="bold" />

                            <Spinner
                                android:id="@+id/spinner_level"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:entries="@array/levels" />
                </LinearLayout>
            <!-- Separator -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/beige_300_theme"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp" />
            </LinearLayout>
                    
                    <!-- Switch específico para incluir Quizzes (antes de los selects relacionados con quizzes) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="8dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Incluir Quizzes"
                            android:textSize="20sp"
                            android:textColor="@color/beige_300_theme"
                            android:textStyle="bold"/>
                        <Switch
                            android:id="@+id/switch_include_quizzes"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:thumbTint="@color/switch_thumb_selector"
                            android:trackTint="@color/switch_track_selector"/>
                    </LinearLayout>
                    <LinearLayout
                        android:id="@+id/quiz_controls_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Tipo de Quiz"
                            android:textColor="@color/black"
                            android:textStyle="bold" />

                        <Spinner
                            android:id="@+id/spinner_quiz_type"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:entries="@array/quiz_types"
                            android:spinnerMode="dropdown"
                            android:popupBackground="@color/colorPrimary" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Límite de Quizzes"
                                android:layout_marginTop="8dp"
                                android:textColor="@color/black"
                                android:textStyle="bold" />

                            <Spinner
                                android:id="@+id/spinner_quiz_limit"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:entries="@array/quiz_limits"
                                android:spinnerMode="dropdown"
                                android:popupBackground="@color/colorPrimary" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Límite de preguntas"
                            android:layout_marginTop="8dp"
                            android:textColor="@color/black"
                            android:textStyle="bold" />

                        <Spinner
                            android:id="@+id/spinner_questions_limit"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:entries="@array/question_limits"
                            android:spinnerMode="dropdown"
                            android:popupBackground="@color/colorPrimary" />

                    </LinearLayout>

                    <!-- Separator -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/beige_300_theme"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="8dp" />

                    <!-- Flashcards section: switch + controls container -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="8dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Incluir Flashcards"
                            android:textSize="20sp"
                            android:textColor="@color/beige_300_theme"
                            android:textStyle="bold"/>
                        <Switch
                            android:id="@+id/switch_include_flashcards"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:thumbTint="@color/switch_thumb_selector"
                            android:trackTint="@color/switch_track_selector"/>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/flashcard_controls_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Límite de Flashcards"
                            android:textColor="@color/black"
                            android:textStyle="bold" />

                        <Spinner
                            android:id="@+id/spinner_flashcard_limit"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:entries="@array/flashcard_limits"
                            android:spinnerMode="dropdown"
                            android:popupBackground="@color/colorPrimary" />

                    </LinearLayout>
                    <!-- Separator debajo de Flashcards -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/beige_300_theme"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="8dp" />
                    

                    <!-- Hot Topics section: switch + controls container -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="8dp">
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Incluir Hot Topics"
                            android:textSize="20sp"
                            android:textColor="@color/beige_300_theme"
                            android:textStyle="bold"/>
                        <Switch
                            android:id="@+id/switch_include_hot_topics"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:thumbTint="@color/switch_thumb_selector"
                            android:trackTint="@color/switch_track_selector"/>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/hot_topics_controls_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginTop="8dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Límite de Hot Topics"
                            android:textColor="@color/black"
                            android:textStyle="bold" />

                        <Spinner
                            android:id="@+id/spinner_hot_topics_limit"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:entries="@array/hot_topic_limits"
                            android:spinnerMode="dropdown"
                            android:popupBackground="@color/colorPrimary" />

                    </LinearLayout>

                    <!-- Separator debajo de Hot Topics -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/beige_300_theme"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="8dp" />


                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Puntos prioritarios (separados por comas)"
                        android:layout_marginTop="8dp"
                        android:textSize="16sp"
                        android:textColor="@color/beige_300_theme"
                        android:textStyle="bold"/>

                    <EditText
                        android:id="@+id/input_priority_topics"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="e.g. Tema 1, Punto 3, Capitulo 5"
                        android:inputType="textMultiLine"
                        android:minLines="2"
                        android:textSize="14sp"
                        android:textColor="@color/beige_300_theme"
                        android:textColorHint="@color/beige_300_theme"/>

                    <!-- Selector de fichero -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Documento (.pdf, .doc, .docx)"
                        android:textStyle="bold"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="6dp"
                        android:textColor="@color/beige_300_theme"
                        android:textSize="16sp"/>

                    <!-- Selected file name (hidden until a file is chosen) -->
                    <TextView
                        android:id="@+id/selected_file_name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:visibility="gone"
                        android:textColor="@color/black"
                        android:layout_marginBottom="8dp"
                        android:textSize="14sp" />

                    <Button
                        android:id="@+id/button_upload_file"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Seleccionar Documento"
                        android:backgroundTint="@color/beige_300_theme"
                        android:textColor="@color/black"/>

                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </ScrollView>

        <!-- Botón final para enviar el formulario (separado del card) -->
        <Button
            android:id="@+id/button_get_study_plan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Crear Plan de Estudio"
            app:backgroundTint="?attr/actionButtonColor"
            android:textColor="@color/white"/>
    </LinearLayout>

    <!-- Fullscreen centered processing overlay (hidden by default). OverlayManager will use these ids: processing_overlay, processing_message, processing_cancel_button -->
    <FrameLayout
        android:id="@+id/processing_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:background="#80000000">

        <androidx.cardview.widget.CardView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            app:cardCornerRadius="12dp"
            app:cardElevation="8dp"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <ProgressBar
                    android:layout_width="56dp"
                    android:layout_height="56dp"
                    style="?android:attr/progressBarStyleLarge"
                    android:indeterminate="true" />

                <TextView
                    android:id="@+id/processing_message"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Procesando: creando plan de estudio"
                    android:textSize="16sp"
                    android:textColor="@color/black" />

                <Button
                    android:id="@+id/processing_cancel_button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Cancelar" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </FrameLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        app:headerLayout="@layout/nav_header_drawer"
        app:menu="@menu/drawer_menu"
        app:itemIconTint="@color/black"
        app:itemTextColor="@color/black"
        app:itemTextAppearance="@style/DrawerMenuTextAppearance" />

</androidx.drawerlayout.widget.DrawerLayout>
