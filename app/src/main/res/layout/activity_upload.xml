<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <include layout="@layout/include_app_header" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="4dp"
                android:paddingBottom="25px">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp"
                    android:background="@color/beige_300_theme">

                    <!-- Título -->
                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/configure_study_plan"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        android:textAlignment="center"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="24dp" />

                    <!-- Inline processing view (kept for backward compatibility but not used by OverlayManager) -->
                    <FrameLayout
                        android:id="@+id/processing_inline_overlay"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:visibility="gone"
                        android:padding="8dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">
                            <ProgressBar
                                android:id="@+id/processing_progress_inline"
                                android:layout_width="48dp"
                                android:layout_height="48dp"
                                style="?android:attr/progressBarStyleLarge"
                                android:indeterminate="true" />

                            <TextView
                                android:id="@+id/processing_status_inline"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:layout_weight="1"
                                android:text="@string/processing"
                                android:textColor="@color/beige_300_theme"
                                android:textSize="16sp"/>
                        </LinearLayout>

                    </FrameLayout>

                    <!-- Formulario de especificaciones del plan (titulo generado en servidor) -->

                    <!-- Idioma and Nivel as label-left / spinner-right rows to match other blocks -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="@string/language"
                                    android:textColor="@color/black"
                                    android:textSize="16sp"
                                    android:textStyle="bold" />

                        <Spinner
                            android:id="@+id/spinner_language"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:entries="@array/languages"
                            android:spinnerMode="dropdown"
                            android:textAlignment="textEnd"
                            android:gravity="end"
                            android:popupBackground="@color/beige_300_theme" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="8dp">

                                <TextView
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:text="@string/level"
                                    android:textColor="@color/black"
                                    android:textSize="16sp"
                                    android:textStyle="bold" />

                        <Spinner
                            android:id="@+id/spinner_level"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:entries="@array/levels"
                            android:spinnerMode="dropdown"
                            android:textAlignment="textEnd"
                            android:gravity="end"
                            android:popupBackground="@color/beige_300_theme" />

                    </LinearLayout>

                    <!-- Separator -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/black"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="16dp" />

                    <!-- Quiz controls: show limits as label + select on one row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/quiz_type"
                            android:textColor="@color/black"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <Spinner
                            android:id="@+id/spinner_quiz_type"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:entries="@array/quiz_types"
                            android:spinnerMode="dropdown"
                            android:textAlignment="textEnd"
                            android:gravity="end"
                            android:popupBackground="@color/beige_300_theme" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="8dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/total_quizzes"
                            android:textColor="@color/black"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <Spinner
                            android:id="@+id/spinner_quiz_limit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:entries="@array/quiz_limits"
                            android:spinnerMode="dropdown"
                            android:textAlignment="textEnd"
                            android:gravity="end"
                            android:popupBackground="@color/beige_300_theme" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginTop="8dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/total_questions"
                            android:textColor="@color/black"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <Spinner
                            android:id="@+id/spinner_questions_limit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:entries="@array/question_limits"
                            android:spinnerMode="dropdown"
                            android:textAlignment="textEnd"
                            android:gravity="end"
                            android:popupBackground="@color/beige_300_theme" />

                    </LinearLayout>

                    <!-- Separator -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/black"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="16dp" />

                    <!-- Flashcards limit (label + select) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/total_flashcards"
                            android:textColor="@color/black"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <Spinner
                            android:id="@+id/spinner_flashcard_limit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:entries="@array/flashcard_limits"
                            android:spinnerMode="dropdown"
                            android:textAlignment="textEnd"
                            android:gravity="end"
                            android:popupBackground="@color/beige_300_theme" />

                    </LinearLayout>
                    <!-- Separator debajo de Flashcards -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/black"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="16dp" />

                    <!-- Hot Topics limit (label + select) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/total_hot_topics"
                            android:textColor="@color/black"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <Spinner
                            android:id="@+id/spinner_hot_topics_limit"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:entries="@array/hot_topic_limits"
                            android:spinnerMode="dropdown"
                            android:textAlignment="textEnd"
                            android:gravity="end"
                            android:popupBackground="@color/beige_300_theme" />

                    </LinearLayout>

                    <!-- Separator debajo de Hot Topics -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/black"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="16dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/priority_points"
                        android:textSize="16sp"
                        android:textColor="@color/black"
                        android:textStyle="bold"/>

                    <EditText
                        android:id="@+id/input_priority_topics"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/priority_points_hint"
                        android:inputType="textMultiLine"
                        android:minLines="2"
                        android:textSize="14sp"
                        android:textColor="@color/black"
                        android:textColorHint="@color/black"
                        android:layout_marginBottom="16dp"/>

                    <!-- Selector de fichero -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/document"
                        android:textStyle="bold"
                        android:layout_marginTop="8dp"
                        android:layout_marginBottom="12dp"
                        android:textColor="@color/black"
                        android:textSize="16sp"/>

                    <!-- Selected file name with delete button (hidden until a file is chosen) -->
                    <LinearLayout
                        android:id="@+id/selected_file_container"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:visibility="gone"
                        android:padding="8dp"
                        android:background="@android:color/white"
                        android:layout_marginBottom="8dp">

                        <TextView
                            android:id="@+id/selected_file_name"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text=""
                            android:textColor="@color/black"
                            android:textSize="14sp"
                            android:ellipsize="middle"
                            android:singleLine="true" />

                        <ImageButton
                            android:id="@+id/button_remove_file"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:layout_marginStart="8dp"
                            android:src="@android:drawable/ic_menu_close_clear_cancel"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/delete_document"
                            android:scaleType="fitCenter"
                            app:tint="@color/red" />

                    </LinearLayout>

                    <Button
                        android:id="@+id/button_upload_file"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/select_document"
                        android:backgroundTint="@color/colorPrimary"
                        android:textColor="@color/beige_300_theme"
                        android:textStyle="bold"
                        android:layout_marginBottom="16dp"/>

                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </ScrollView>

        <!-- Botón final para enviar el formulario (separado del card) -->
        <Button
            android:id="@+id/button_get_study_plan"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/create"
            android:backgroundTint="@color/colorPrimary"
            android:textColor="@color/beige_300_theme"
            android:textStyle="bold"/>
    </LinearLayout>

    <!-- Fullscreen centered processing overlay (hidden by default). OverlayManager will use these ids: processing_overlay, processing_message, processing_cancel_button -->
    <FrameLayout
        android:id="@+id/processing_overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:background="#80000000">

        <androidx.cardview.widget.CardView
            android:layout_width="320dp"
            android:layout_height="320dp"
            android:layout_gravity="center"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:gravity="center">

                <ImageView
                    android:id="@+id/processing_stage_image"
                    android:layout_width="160dp"
                    android:layout_height="160dp"
                    android:src="@drawable/ic_load_plan_1"
                    android:contentDescription="@string/plan_creation_illustration"
                    android:scaleType="fitCenter" />

                <TextView
                    android:id="@+id/processing_message"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/preparing_plan"
                    android:textSize="14sp"
                    android:textColor="@color/black"
                    android:textStyle="normal" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </FrameLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        app:headerLayout="@layout/nav_header_drawer"
        app:menu="@menu/drawer_menu"
        app:itemIconTint="@color/black"
        app:itemTextColor="@color/black"
        app:itemTextAppearance="@style/DrawerMenuTextAppearance" />

</androidx.drawerlayout.widget.DrawerLayout>
