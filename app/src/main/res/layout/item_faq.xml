<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="5dp"
    android:layout_marginBottom="5dp"
    app:cardCornerRadius="8dp"
    app:cardBackgroundColor="@color/beige_300_theme"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Question (always visible) -->
        <LinearLayout
            android:id="@+id/faq_question_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/faq_pregunta"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/faq_question"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="@color/colorPrimary"
                android:paddingEnd="16dp" />

            <ImageView
                android:id="@+id/faq_expand_icon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@android:drawable/ic_menu_more"
                android:contentDescription="@string/expand_collapse"
                app:tint="@color/colorPrimary" />

        </LinearLayout>

        <!-- Answer (hidden by default) -->
        <TextView
            android:id="@+id/faq_respuesta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/faq_answer"
            android:textSize="14sp"
            android:textColor="@color/black"
            android:layout_marginTop="12dp"
            android:paddingTop="12dp"
            android:paddingBottom="0dp"
            android:visibility="gone" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
