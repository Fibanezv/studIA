<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:windowBackground">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_above="@id/study_nav"
            android:orientation="vertical"
            android:padding="16dp"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <!-- Standard app header -->
            <include layout="@layout/include_app_header" />

            <!-- Contenedor que ocupa el espacio restante y centra verticalmente la barra+tarjeta -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="top"
                    android:paddingTop="8dp">

                    <!-- Etiqueta de progreso -->
                    <TextView
                        android:id="@+id/quiz_progress_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Progreso"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:textColor="@color/black"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginBottom="12dp" />

                    <!-- Contenedor de track y fill. Altura reducida para mejor proporción -->
                    <FrameLayout
                        android:id="@+id/quiz_progress_container"
                        android:layout_width="match_parent"
                        android:layout_height="28dp"
                        android:layout_marginStart="40dp"
                        android:layout_marginEnd="40dp"
                        android:layout_gravity="center_horizontal"
                        android:layout_marginBottom="24dp"
                        android:foregroundGravity="center_vertical">

                        <!-- Track (parte no contestada) -->
                        <View
                            android:id="@+id/quiz_progress_track"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/progress_track_shape" />

                        <!-- Fill (parte contestada). Width se animará en tiempo de ejecución -->
                        <View
                            android:id="@+id/quiz_progress_fill"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:background="@drawable/progress_fill_shape" />

                    </FrameLayout>

                    <androidx.cardview.widget.CardView
                        android:id="@+id/card_upload"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="16dp"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        app:cardElevation="6dp"
                        app:cardCornerRadius="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="16dp"
                            android:background="@color/beige_300_theme"
                            android:gravity="center_vertical">

                            <TextView
                                android:id="@+id/question_text"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Pregunta"
                                android:textSize="18sp"
                                android:maxLines="3"
                                android:ellipsize="end"
                                android:textColor="@color/black"
                                android:textStyle="bold"
                                android:layout_marginBottom="12dp"
                                android:gravity="start"
                                android:layout_gravity="top"/>

                            <RadioGroup
                                android:id="@+id/options_group"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/submit_button"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="Responder"
                                android:layout_marginTop="24dp"
                                app:backgroundTint="@color/colorPrimary"
                                android:textColor="@color/white"/>

                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                </LinearLayout>

            </FrameLayout>

        </LinearLayout>

        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/study_nav"
            android:layout_alignParentBottom="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:labelVisibilityMode="labeled"
            app:menu="@menu/menu_study_nav"
            android:background="@android:color/transparent"
            app:itemRippleColor="@android:color/transparent"
            app:itemIconTint="@color/selector_nav_color"
            app:itemTextColor="@color/selector_nav_text"
            app:itemActiveIndicatorStyle="@style/CustomActiveIndicator"
            />

    </RelativeLayout>

    <com.google.android.material.navigation.NavigationView
        android:id="@+id/nav_view"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        app:headerLayout="@layout/nav_header_drawer"
        app:menu="@menu/drawer_menu"
        app:itemIconTint="@color/black"
        app:itemTextColor="@color/black"
        app:itemTextAppearance="@style/DrawerMenuTextAppearance" />

</androidx.drawerlayout.widget.DrawerLayout>
