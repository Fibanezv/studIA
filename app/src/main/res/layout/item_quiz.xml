<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/item_background"
    android:padding="16dp"
    android:layout_marginTop="5dp"
    android:layout_marginBottom="5dp"
    android:clickable="true"
    android:focusable="true">

    <!-- Título grande del quiz -->
    <TextView
        android:id="@+id/quiz_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Quiz title"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/colorPrimary" />

    <TextView
        android:id="@+id/quiz_typology"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Tipo: A,B,C,D"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="@color/black"
        android:layout_marginTop="4dp" />

    <!-- Nota: Se elimina la barra de progreso en el item. El % se muestra junto al icono y hay un botón Reiniciar si está al 100% -->

    <!-- Fila simple: icono + % completado + botón Reiniciar (solo visible al 100%) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="5dp"
        android:gravity="center_vertical">

        <!-- Progreso label + porcentaje -->
        <TextView
            android:id="@+id/quiz_progress_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Progreso:"
            android:textSize="14sp"
            android:textColor="@color/colorPrimary"
            android:layout_marginEnd="5dp"
            android:textStyle="bold"
            android:layout_gravity="center_vertical" />

        <TextView
            android:id="@+id/quiz_percent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0%"
            android:textSize="14sp"
            android:textColor="@color/black"
            android:textStyle="bold"
            android:layout_marginEnd="10dp"
            android:layout_gravity="center_vertical" />

        <!-- Nota final label + value -->
        <TextView
            android:id="@+id/quiz_score_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Nota final:"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/colorPrimary"
            android:layout_marginStart="2dp"
            android:visibility="gone"
            android:layout_gravity="center_vertical" />

        <TextView
            android:id="@+id/quiz_score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:layout_marginStart="5dp"
            android:visibility="gone"
            android:layout_gravity="center_vertical" />

        <!-- Spacer -->
        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

    </LinearLayout>

    <!-- Botones Resultados y Reiniciar: solo visibles cuando el quiz está al 100% -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp"
        android:gravity="start">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_results_quiz"
            style="?attr/materialButtonStyle"
            android:layout_width="90dp"
            android:layout_height="wrap_content"
            android:text="Resultados"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:visibility="gone"
            android:textSize="11sp"
            android:paddingLeft="4dp"
            android:paddingRight="4dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:minHeight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:textColor="@color/colorOnSecondary"
            app:backgroundTint="@color/colorSecondary"
            android:layout_marginEnd="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_reset_quiz"
            style="?attr/materialButtonStyle"
            android:layout_width="90dp"
            android:layout_height="wrap_content"
            android:text="Reiniciar"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:visibility="gone"
            android:textSize="11sp"
            android:paddingLeft="4dp"
            android:paddingRight="4dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:minHeight="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:textColor="@color/white"
            app:backgroundTint="@color/colorAccent" />

    </LinearLayout>

</LinearLayout>